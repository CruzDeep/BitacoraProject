{
  "name": "bitacora",
  "version": "1.0.0",
  "description": "Proyecto Bitácora con Express y Webpack",
  "main": "src/server.js",
  "scripts": {
    "dev": "concurrently \"nodemon src/server.js\" \"webpack serve --config webpack.client.config.js --mode development --open\"",
    "build": "webpack --config webpack.client.config.js --mode production",
    "start": "node src/server.js"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.7.3",
    "nodemon": "^3.1.10",
    "style-loader": "^3.3.3",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.11.0"
  }
}
